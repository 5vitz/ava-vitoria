generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SiteSettings {
  id           String   @id @default(uuid()) @db.Uuid
  config_key   String   @unique @db.VarChar(100)
  config_value Json     @db.JsonB
  updated_at   DateTime @default(now()) @updatedAt

  @@map("site_settings")
}

model Product {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(255)
  slug          String         @unique @db.VarChar(255)
  description   String?        @db.Text
  price         Decimal        @db.Decimal(10, 2)
  is_active     Boolean        @default(true)
  display_order Int            @default(0)
  card_type     Int            @default(1)
  size_chart    Json?          @db.JsonB
  collection_id String?        @db.Uuid
  collection    Collection?    @relation(fields: [collection_id], references: [id], onDelete: SetNull)
  sku_master           String?        @db.VarChar(100)
  product_category     String         @default("CAMISETA_PRIME") @db.VarChar(50)
  supplier_provider    String         @default("DIMONA") @db.VarChar(50)
  supplier_item_code   String?        @db.VarChar(100)
  cost_price           Decimal?       @db.Decimal(10, 2)
  cost_baseline        Decimal?       @db.Decimal(10, 2)
  target_margin_percent Decimal?      @db.Decimal(5, 2)
  is_price_indexed     Boolean        @default(true)
  ncm                  String?        @default("6109.10.00") @db.VarChar(20)
  weight_grams         Int?           @default(180)
  dimensions           Json?          @db.JsonB
  print_file_front_url String?        @db.VarChar(512)
  print_file_back_url  String?        @db.VarChar(512)
  artwork_id           String?        @db.Uuid
  artwork              Artwork?       @relation(fields: [artwork_id], references: [id], onDelete: SetNull)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @default(now()) @updatedAt
  images        ProductImage[]
  variants      StockVariant[]

  @@map("products")
}

model ProductImage {
  id            String  @id @default(uuid()) @db.Uuid
  product_id    String  @db.Uuid
  product       Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  image_url     String  @db.VarChar(512)
  display_order Int     @default(0)

  @@map("product_images")
}

model StockVariant {
  id         String      @id @default(uuid()) @db.Uuid
  product_id String      @db.Uuid
  product    Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  size       String      @db.VarChar(50)
  color      String      @db.VarChar(100)
  quantity   Int         @default(0)
  order_items OrderItem[]

  @@unique([product_id, size, color])
  @@map("stock_variants")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  status         String      @default("pending") @db.VarChar(50)
  total_amount   Decimal     @db.Decimal(10, 2)
  customer_email String      @db.VarChar(255)
  customer_name  String      @db.VarChar(255)
  payment_id     String?     @unique @db.VarChar(255)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @default(now()) @updatedAt
  items          OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String       @id @default(uuid()) @db.Uuid
  order_id   String       @db.Uuid
  order      Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  variant_id String       @db.Uuid
  variant    StockVariant @relation(fields: [variant_id], references: [id], onDelete: Restrict)
  quantity   Int
  unit_price Decimal      @db.Decimal(10, 2)

  @@map("order_items")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  username   String   @unique @db.VarChar(100)
  password   String   @db.VarChar(255)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("users")
}

model MediaAsset {
  id            String      @id @default(uuid()) @db.Uuid
  filename      String      @db.VarChar(255)
  file_url      String      @db.VarChar(512)
  mime_type     String      @db.VarChar(100)
  collection_id String?     @db.Uuid
  collection    Collection? @relation(fields: [collection_id], references: [id], onDelete: SetNull)
  created_at    DateTime    @default(now())

  @@map("media_assets")
}

model Collection {
  id         String       @id @default(uuid()) @db.Uuid
  name       String       @unique @db.VarChar(100)
  slug       String       @unique @db.VarChar(100)
  year       Int
  season     String       @db.VarChar(50)
  created_at DateTime     @default(now())
  updated_at DateTime     @default(now()) @updatedAt
  products   Product[]
  medias     MediaAsset[]

  @@map("collections")
}

model Artwork {
  id                      String    @id @default(uuid()) @db.Uuid
  code                    String    @unique @db.VarChar(50)
  title                   String    @db.VarChar(255)
  concept                 String?   @db.Text
  project_folder          String    @default("Testes") @db.VarChar(100)
  is_registered           Boolean   @default(false)
  coa_hash_sha256         String?   @db.VarChar(64)
  mutated_keys_count      Int       @default(0)
  writing_matrix_26       Json?     @db.JsonB
  master_print_dimona_url String?   @db.VarChar(512)
  master_print_reserva_url String?  @db.VarChar(512)
  preview_image_url       String?   @db.VarChar(512)
  default_supplier        String    @default("DIMONA") @db.VarChar(50)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @default(now()) @updatedAt
  products                Product[]

  @@map("artworks")
}

model CategoryMarginRule {
  id                    String   @id @default(uuid()) @db.Uuid
  category_code         String   @unique @db.VarChar(50)
  category_label        String   @db.VarChar(100)
  target_margin_percent Decimal  @db.Decimal(5, 2)
  drop_indexing_mode    String   @default("INDEXED") @db.VarChar(20)
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now()) @updatedAt

  @@map("category_margin_rules")
}

model SupplierCatalogItem {
  id                String   @id @default(uuid()) @db.Uuid
  supplier_code     String   @db.VarChar(50)
  item_code         String   @unique @db.VarChar(100)
  item_name         String   @db.VarChar(255)
  print_mode        String   @default("FRENTE") @db.VarChar(50)
  dimensions_px     String?  @db.VarChar(50)
  cost_current      Decimal  @db.Decimal(10, 2)
  cost_baseline     Decimal  @db.Decimal(10, 2)
  public_source_url String?  @db.VarChar(512)
  last_checked_at   DateTime @default(now())
  last_changed_at   DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now()) @updatedAt

  @@map("supplier_catalog_items")
}
